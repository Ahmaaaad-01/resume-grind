{
  "_meta": {
    "description": "Canonical design tokens for Prediction Markets. Dark-mode only.",
    "version": "1.0.0",
    "usage": "Import these tokens into your Tailwind config, CSS custom properties, or design tool. Semantic names (bg-primary, bg-surface, text-heading, etc.) should be used in code — never raw hex values."
  },

  "color": {
    "bg-primary":      "#020617",
    "bg-surface":      "#0F172A",
    "accent-500":      "#38BDF8",
    "accent-600":      "#0EA5E9",
    "text-heading":    "#F8FAFC",
    "text-body":       "#94A3B8",
    "border-subtle":   "rgba(255,255,255,0.08)",

    "status-green":    "#4ADE80",
    "status-yellow":   "#FACC15",
    "status-red":      "#F87171"
  },

  "typography": {
    "font-family-sans":  "'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif",
    "font-family-mono":  "'Geist Mono', ui-monospace, SFMono-Regular, monospace",

    "heading-h1": {
      "size": "2.25rem",
      "weight": 700,
      "letter-spacing": "-0.02em",
      "line-height": 1.2
    },
    "heading-h2": {
      "size": "1.5rem",
      "weight": 600,
      "letter-spacing": "-0.02em",
      "line-height": 1.3
    },
    "heading-h3": {
      "size": "1.125rem",
      "weight": 600,
      "letter-spacing": "-0.02em",
      "line-height": 1.4
    },
    "body": {
      "size": "0.875rem",
      "weight": 400,
      "letter-spacing": "normal",
      "line-height": 1.625
    },
    "small": {
      "size": "0.75rem",
      "weight": 500,
      "letter-spacing": "0.05em",
      "line-height": 1.5
    },
    "ticker": {
      "size": "0.625rem",
      "weight": 400,
      "letter-spacing": "0.02em",
      "line-height": 1.4
    }
  },

  "spacing": {
    "xs":  "0.25rem",
    "sm":  "0.5rem",
    "md":  "1rem",
    "lg":  "1.5rem",
    "xl":  "2.5rem",
    "2xl": "5rem",
    "3xl": "8rem"
  },

  "radius": {
    "sm":   "6px",
    "md":   "8px",
    "lg":   "16px",
    "full": "9999px"
  },

  "shadow": {
    "glow-sm":  "0 0 10px rgba(56,189,248,0.08)",
    "glow":     "0 0 20px rgba(56,189,248,0.10), 0 0 60px rgba(56,189,248,0.05)",
    "glow-lg":  "0 0 30px rgba(56,189,248,0.15), 0 0 80px rgba(56,189,248,0.08)",
    "surface":  "0 1px 3px rgba(0,0,0,0.4), 0 1px 2px rgba(0,0,0,0.3)"
  }
}
